GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=gemini-3.8-flash
GEMINI_VIDEO_PROCESSING=agentic
GEMINI_VIDEO_MEDIA_RESOLUTION=high
REQUEST_TIMEOUT_SECONDS=300

# Optional future providers
TWELVELABS_API_KEY=
OPENAI_API_KEY=

# OpenAI-compatible chat/completions endpoint for base/gemma-4-31b-it.
GEMMA_API_KEY=
GEMMA_CHAT_COMPLETIONS_URL=
GEMMA_MODEL=base/gemma-4-31b-it
GEMMA_VERIFY_TLS=true
GEMMA_FRAME_TAIL_SECONDS=600
GEMMA_FRAME_MAX_FRAMES=12
GEMMA_FRAME_MAX_HEIGHT=360
GEMMA_FRAME_JPEG_QUALITY=16
GEMMA_REQUEST_MAX_BYTES=40000
GEMMA_SCORE_SCAN_INTERVAL_SECONDS=20
GEMMA_SCORE_SCAN_MAX_FRAMES=96
GEMMA_SCORE_SCAN_BATCH_SIZE=1
YTDLP_VERIFY_TLS=true

# Local queue worker. Set the same VIDEO_WORKER_TOKEN on the main Render site.
WORKER_API_BASE_URL=https://honeyserve-elo.onrender.com
VIDEO_WORKER_TOKEN=
VIDEO_WORKER_ID=honeyserve-local-worker
WORKER_VERIFY_TLS=true
WORKER_POLL_SECONDS=10
WORKER_RESULT_UPLOAD_SOFT_LIMIT_BYTES=40000
WORKER_REFERENCE_FRAME_MAX_HEIGHT=120
WORKER_REFERENCE_FRAME_JPEG_QUALITY=16
